# Local development defaults. Do not reuse these values in a public deployment.
DATABASE_URL=postgresql://postgres:agentops-local-only@localhost:5432/agentops
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_RECOVERIES=3
WORKER_CONTROL_POLL_SECONDS=0.25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENVIRONMENT=development
API_AUTH_ENABLED=false
API_KEY=
API_RATE_LIMIT_PER_MINUTE=0
# Identity rollout is local/test-only until tenant and role enforcement is complete.
IDENTITY_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
IDENTITY_SESSION_SECONDS=3600
