{
    admin off
    auto_https off
}
:8081 {
    respond /health "ok" 200
}
:8443 {
    tls /run/secrets/tls_certificate /run/secrets/tls_key
    @untrusted not host localhost gateway
    route {
    respond @untrusted "Untrusted host" 421
    handle_path /api/* {
        reverse_proxy api:8000 {
            header_up Host api
        }
    }
    handle /oidc/* {
        reverse_proxy oidc:8080
    }
    handle {
        reverse_proxy web:3000
    }
    }
}
