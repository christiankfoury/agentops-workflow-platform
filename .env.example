# Local development only. Copy to .env for Docker Compose.
OPENAI_API_KEY=
POSTGRES_PASSWORD=agentops-local-only

# The local demo is unauthenticated by default. Public deployments must enable
# authentication, use a strong secret, and configure a positive rate limit.
API_AUTH_ENABLED=false
API_KEY=
API_RATE_LIMIT_PER_MINUTE=0

# Optional Production AI Platform telemetry. Placeholder-only defaults.
AGENTOPS_TELEMETRY_ENABLED=false
AGENTOPS_TELEMETRY_ENDPOINT=http://localhost:8000/v1/usage/llm-events
AGENTOPS_TELEMETRY_API_KEY=agentops-local-placeholder-key-not-a-secret
AGENTOPS_TELEMETRY_TIMEOUT_SECONDS=2
AGENTOPS_TELEMETRY_MAX_METADATA_BYTES=2048
AGENTOPS_TELEMETRY_REDACT_CONTENT=true
